{
  "i18n-ally.localesPaths": [
    "lang"
  ],
  "i18n-ally.keystyle": "nested",
  "mago.executablePath": "/Users/seaside/.cargo/bin/mago",
  "mago.suppressExperimentalWarning": true,
  "git.ignoreLimitWarning": true,
  "intelephense.files.exclude": [
    "**/bootstrap/cache/**",
    "**/.phpunit.cache/**",
    "app/Exports/**",
    "app/Imports/**",
    "**/.phpstorm.meta.php",
    "**/deploy.php"
  ],
  "intelephense.diagnostics.duplicateSymbols": false,
  "intelephense.environment.phpVersion": "8.5",
  "intelephense.format.enable": false,
  "LaravelExtraIntellisense.disableDiagnostics": true,
  "laravel.diagnostics.env": false,
  "laravel.diagnostics.enabled": false,
  "laravel.env.diagnostics": false,
  "[php]": {
    "editor.defaultFormatter": "open-southeners.laravel-pint",
    "editor.formatOnSave": true
  },
  "[blade]": {
    "editor.formatOnSave": true
  },
  "tailwindCSS.includeLanguages": {
    "blade": "html"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/storage/framework": true,
    "**/storage/logs": true,
    "**/bootstrap/cache": true,
    "**/.phpunit.cache": true,
    "**/.phpstorm.meta.php": true,
    "**/_ide_helper.php": true,
    "**/_ide_helper_models.php": true
  },
  "files.exclude": {
    "**/.phpunit.cache": true,
    "**/.DS_Store": true,
    "**/.phpstorm.meta.php": true,
    "**/_ide_helper.php": true,
    "**/_ide_helper_models.php": true
  }
}

