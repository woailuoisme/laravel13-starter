{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "codegraph": {
            "command": "codegraph",
            "args": [
                "serve",
                "--mcp"
            ]
        },
        "code-review-graph": {
            "command": "code-review-graph",
            "args": [
                "serve"
            ]
        }
    }
}