{
  "preset": "laravel",
  "exclude": [
    "lang"
  ],
  "notName": [
    "_ide_helper.php",
    "_ide_helper_models.php",
    "_ide_helper_models_phpstan.php",
    "_ide_helper_phpstan.php",
    ".phpstorm.meta.php"
  ],
  "rules": {
    "new_with_parentheses": {
      "anonymous_class": true,
      "named_class": true
    },
    "strict_comparison": true,
    "no_useless_else": true,
    "no_superfluous_elseif": true,
    "array_push": true,
    "backtick_to_shell_exec": true,
    "self_accessor": true,
    "modernize_types_casting": true,
    "ordered_imports": {
      "sort_algorithm": "alpha",
      "imports_order": [
        "class",
        "function",
        "const"
      ]
    },
    "trailing_comma_in_multiline": {
      "elements": [
        "arguments",
        "array_destructuring",
        "arrays",
        "match",
        "parameters"
      ]
    }
  }
}
