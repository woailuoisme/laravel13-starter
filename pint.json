{
  "preset": "laravel",
  "exclude": [
    "lang"
  ],
  "notName": [
    "_ide_helper.php",
    "_ide_helper_models.php",
    ".phpstorm.meta.php"
  ],
  "rules": {
    "global_namespace_import": {
      "import_classes": true,
      "import_constants": true,
      "import_functions": true
    },
    "modernize_types_casting": true,
    "strict_comparison": true
  }
}
